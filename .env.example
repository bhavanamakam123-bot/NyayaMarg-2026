# Server
PORT=4000
APP_URL=http://localhost:5173
# Leave blank to auto-generate a persistent secret in data/session.secret
SESSION_SECRET=

# Password reset email. Without SMTP, development can show a one-time reset link.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=NyayaMarg <noreply@localhost>
ALLOW_DEV_RESET_LINK=true

# Optional. Provisions always come from the local verified knowledge base.
# A configured model may only simplify wording; it cannot add section numbers.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional Google Maps. Without these, NyayaMarg uses address search and an embed fallback.
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=
